# Server Port (Render sets this automatically)
PORT=5000

# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret for Session Signing
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (e.g. https://your-gamehub.vercel.app)
FRONTEND_URL=https://your-gamehub.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-gamehub.vercel.app
